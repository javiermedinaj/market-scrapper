{
  "name": "test-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stage1": "node --env-file-if-exists=.env --import tsx src/cli/stage1.ts",
    "stage2": "node --env-file-if-exists=.env --env-file-if-exists=../prototype-next/.env.local --import tsx src/cli/stage2.ts",
    "view": "node --env-file-if-exists=.env --import tsx scripts/serve.ts",
    "test:unit": "node --import tsx --test tests/unit.test.ts",
    "test:baseline": "node --env-file-if-exists=.env --env-file-if-exists=../prototype-next/.env.local --import tsx tests/baseline.ts",
    "test:dia": "node --env-file-if-exists=.env --env-file-if-exists=../prototype-next/.env.local --import tsx tests/baseline.ts dia",
    "test:jumbo": "node --env-file-if-exists=.env --env-file-if-exists=../prototype-next/.env.local --import tsx tests/baseline.ts jumbo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "^7.0.142",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
